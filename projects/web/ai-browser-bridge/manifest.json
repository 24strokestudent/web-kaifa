{
  "manifest_version": 3,
  "name": "开发练习册 · 官网对话桥接原型",
  "version": "0.2.3",
  "description": "在自己的学习工作台中操作已登录的 AI 官网标签页。实验原型，不使用模型 API。",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.doubao.com/*",
    "https://chatglm.cn/*"
  ],
  "host_permissions": [
    "https://zhouwu97.github.io/web-kaifa/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开学习与 AI 工作台"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://zhouwu97.github.io http://localhost:8743 http://127.0.0.1:8743; connect-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zhouwu97.github.io/web-kaifa/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "workbook-sites.js",
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel-mode.js",
        "workbook-sites.js",
        "theme.css",
        "panel.css",
        "panel.js",
        "providers.js"
      ],
      "matches": [
        "https://zhouwu97.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
